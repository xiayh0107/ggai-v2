{
  "name": "ggai",
  "private": true,
  "version": "0.1.0",
  "description": "Generative graphics canvas with a local Agent daemon",
  "license": "UNLICENSED",
  "type": "module",
  "packageManager": "npm@10.9.8",
  "engines": {
    "node": ">=22.22.0 <23 || >=24.0.0 <25",
    "npm": ">=10.9.0 <12"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=22.22.0 <23 || >=24.0.0 <25",
      "onFail": "warn"
    },
    "packageManager": {
      "name": "npm",
      "version": ">=10.9.0 <12",
      "onFail": "warn"
    }
  },
  "scripts": {
    "dev": "node scripts/dev-all.mjs",
    "dev:frontend": "vite",
    "dev:all": "node scripts/dev-all.mjs",
    "build": "tsc -b && npm run build:daemon && vite build",
    "build:daemon": "node scripts/clean-daemon-output.mjs dist-daemon && tsc -p tsconfig.daemon.json",
    "build:daemon:test": "node scripts/clean-daemon-output.mjs dist-daemon-test && tsc -p tsconfig.daemon-test.json",
    "daemon": "npm run build:daemon && node dist-daemon/daemon/index.js",
    "daemon:start": "node dist-daemon/daemon/index.js",
    "test": "npm run test:startup && npm run test:daemon && npm run test:ui",
    "test:startup": "node --test scripts/*.test.mjs",
    "test:daemon": "npm run build:daemon:test && node --test dist-daemon-test/daemon/__tests__/*.test.js",
    "test:ui": "vitest run src/",
    "ui:render:serve": "vite --host 127.0.0.1 --port 4173 --strictPort",
    "ui:render:capture": "node scripts/capture-ui-render.mjs",
    "lint": "eslint .",
    "lint:core": "eslint daemon src/agent src/canvas src/components/canvas --max-warnings=0",
    "architecture:check": "node scripts/check-app-architecture.mjs",
    "deps:check": "node scripts/check-dependencies.mjs",
    "deps:doctor": "node scripts/dependency-doctor.mjs",
    "deps:audit": "npm audit --audit-level=low",
    "deps:outdated": "npm outdated",
    "deps:sbom": "npm sbom --package-lock-only --sbom-format cyclonedx --sbom-type application",
    "package:daemon": "npm run deps:check && npm run build:daemon && node scripts/package-daemon.mjs",
    "package:daemon:verify": "npm run package:daemon && npm ci --prefix release/daemon --omit=dev && node release/daemon/daemon/index.js --help",
    "verify": "npm run deps:check && npm run architecture:check && npm run lint && npm test && npm run build && npm run package:daemon:verify",
    "preview": "vite preview"
  },
  "dependencies": {
    "@radix-ui/react-accordion": "1.2.12",
    "@radix-ui/react-alert-dialog": "1.1.15",
    "@radix-ui/react-aspect-ratio": "1.1.8",
    "@radix-ui/react-avatar": "1.1.11",
    "@radix-ui/react-checkbox": "1.3.3",
    "@radix-ui/react-collapsible": "1.1.12",
    "@radix-ui/react-context-menu": "2.2.16",
    "@radix-ui/react-dialog": "1.1.15",
    "@radix-ui/react-dropdown-menu": "2.1.16",
    "@radix-ui/react-hover-card": "1.1.15",
    "@radix-ui/react-label": "2.1.8",
    "@radix-ui/react-menubar": "1.1.16",
    "@radix-ui/react-navigation-menu": "1.2.14",
    "@radix-ui/react-popover": "1.1.15",
    "@radix-ui/react-progress": "1.1.8",
    "@radix-ui/react-radio-group": "1.3.8",
    "@radix-ui/react-scroll-area": "1.2.10",
    "@radix-ui/react-select": "2.2.6",
    "@radix-ui/react-separator": "1.1.8",
    "@radix-ui/react-slider": "1.3.6",
    "@radix-ui/react-slot": "1.2.4",
    "@radix-ui/react-switch": "1.2.6",
    "@radix-ui/react-tabs": "1.1.13",
    "@radix-ui/react-toggle": "1.1.10",
    "@radix-ui/react-toggle-group": "1.1.11",
    "@radix-ui/react-tooltip": "1.2.8",
    "chokidar": "5.0.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "embla-carousel-react": "8.6.0",
    "input-otp": "1.4.2",
    "lucide-react": "0.562.0",
    "next-themes": "0.4.6",
    "react": "19.2.8",
    "react-day-picker": "9.13.0",
    "react-dom": "19.2.8",
    "react-hook-form": "7.70.0",
    "react-resizable-panels": "4.2.2",
    "react-router": "8.3.0",
    "recharts": "3.10.1",
    "sonner": "2.0.7",
    "tailwind-merge": "3.4.0",
    "vaul": "1.1.2"
  },
  "devDependencies": {
    "@eslint/js": "9.39.2",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.20.1",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.1.2",
    "eslint": "9.39.2",
    "eslint-plugin-react-hooks": "7.0.1",
    "eslint-plugin-react-refresh": "0.4.26",
    "globals": "16.5.0",
    "jsdom": "30.0.1",
    "postcss": "8.5.25",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.52.0",
    "vite": "7.3.6",
    "vitest": "4.1.10"
  }
}
