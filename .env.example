# Browser → local daemon
VITE_GGAI_DAEMON_URL=http://127.0.0.1:7380

# `codex` or an acpx adapter id such as `acpx:codex`
VITE_GGAI_AGENT_ID=codex

# Must resolve underneath the daemon's --project-root
VITE_GGAI_PROJECT_DIR=.

# Canvas V2 is the default. A new checkout still requires the explicit
# `npm run canvas:v2:reset -- --apply` marker before the daemon will start.
# Set both values to 0 only for archived V1 rollback diagnostics; the app UI is V2-only.
GGAI_CANVAS_MODEL_V2=1
VITE_GGAI_CANVAS_MODEL_V2=1
