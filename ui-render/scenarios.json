        "主操作只有一个，辅助入口保持轻量。"
      ],
      "checks": [
        { "kind": "selector-visible", "selector": "[data-testid^='canvas-task-run-panel-']", "label": "真实 Task 运行控件可见" },
        { "kind": "selector-count", "selector": "[data-testid='canvas-generation-preflight-notice']", "count": 0, "label": "ready 状态不显示冗余提示" },
        { "kind": "text-absent", "text": "digest", "label": "不泄漏内部能力身份" }
