        { "kind": "selector-visible", "selector": "[aria-label='当前节点状态契约']", "label": "当前生命周期与控制归属可见" },
        { "kind": "text-present", "text": "生成、权限和重试始终由所属 Task 控制", "label": "Studio 明示 Task 控权边界" },
        { "kind": "text-absent", "text": "空态标题", "label": "不再提供无效的插件空态编辑" }
      ]
    },
    {
