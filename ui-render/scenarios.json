    },
    {
      "id": "task-run-skills-workbench",
      "title": "空输出节点 · 打开既有节点 Skills 工作台",
      "viewport": { "width": 1280, "height": 800 },
      "readySelector": "[data-ui-render-scenario='task-run-skills-workbench'][data-ui-render-settled='true'] [aria-label='节点 Skills'] [aria-label='可用 Skills']"
